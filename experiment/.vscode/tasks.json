{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend Server",
            "type": "shell",
            "command": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Start Backend (with venv)",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}\\app\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
            },
            "linux": {
                "command": "${workspaceFolder}/app/.venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
            },
            "osx": {
                "command": "${workspaceFolder}/app/.venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Start Flutter Frontend",
            "type": "shell",
            "command": "flutter run -d edge",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": {
                    "TMP": "D:\\flutter_temp",
                    "TEMP": "D:\\flutter_temp",
                    "TMPDIR": "D:\\flutter_temp",
                    "FLUTTER_TMP": "D:\\flutter_temp"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Start Flutter Frontend (Windows Desktop)",
            "type": "shell",
            "command": "flutter run -d windows",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": {
                    "TMP": "D:\\flutter_temp",
                    "TEMP": "D:\\flutter_temp",
                    "TMPDIR": "D:\\flutter_temp",
                    "FLUTTER_TMP": "D:\\flutter_temp"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Start Flutter Frontend (Web)",
            "type": "shell",
            "command": "flutter run -d web-server --web-port=8080",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": {
                    "TMP": "D:\\flutter_temp",
                    "TEMP": "D:\\flutter_temp",
                    "TMPDIR": "D:\\flutter_temp",
                    "FLUTTER_TMP": "D:\\flutter_temp"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Start All (Backend + Frontend)",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Start Backend (with venv)",
                "Start Flutter Frontend"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            }
        },
        {
            "label": "Install Backend Dependencies",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}\\app\\.venv\\Scripts\\pip.exe install -r app/requirements.txt"
            },
            "linux": {
                "command": "${workspaceFolder}/app/.venv/bin/pip install -r app/requirements.txt"
            },
            "osx": {
                "command": "${workspaceFolder}/app/.venv/bin/pip install -r app/requirements.txt"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            }
        },
        {
            "label": "Install Flutter Dependencies",
            "type": "shell",
            "command": "flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": {
                    "TMP": "D:\\flutter_temp",
                    "TEMP": "D:\\flutter_temp",
                    "TMPDIR": "D:\\flutter_temp",
                    "FLUTTER_TMP": "D:\\flutter_temp"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true,
                "echo": true
            }
        }
    ]
}

