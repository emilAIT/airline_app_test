# Environment variables for ZaKu backend

# Application
APP_NAME=ZaKu
DEBUG=True

# Database
DATABASE_URL=sqlite:///./zaku.db

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (для Flutter app во время разработки)
ALLOWED_ORIGINS=["http://localhost:*", "http://127.0.0.1:*"]

# Seat Hold
SEAT_HOLD_DURATION_MINUTES=10
